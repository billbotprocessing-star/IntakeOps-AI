# ── VAPI VOICE ENGINE ──────────────────────────────────────────────────────────
VAPI_API_KEY=your_vapi_key_here

# ── LLM BRAIN ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here

# ── N8N AUTOMATION ─────────────────────────────────────────────────────────────
# Base URL of your n8n instance (no trailing slash)
N8N_WEBHOOK_URL=https://your-instance.n8n.cloud/webhook

# ── INTAKEOPS API (Netlify Functions) ──────────────────────────────────────────
# Your Netlify site URL + /api — goes in each n8n workflow's Config node as site_api_url
CRM_WEBHOOK_URL=https://your-site.netlify.app/api
# Secret shared between n8n and the functions. Required — without it every
# webhook call is refused.
INTAKEOPS_API_KEY=generate_a_random_secret_here
# Optional: where the landing page's demo form is forwarded
N8N_DEMO_WEBHOOK_URL=https://your-instance.n8n.cloud/webhook/demo-request

# ── SUPABASE (database + dashboard login) ──────────────────────────────────────
# Server side (Netlify Functions) — keep the service role key secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Browser side (baked into the site at build time) — anon key only
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# ── TWILIO SMS ─────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Phone number to page for emergencies
ON_CALL_PHONE=+1XXXXXXXXXX

# ── CALENDAR INTEGRATION ───────────────────────────────────────────────────────
# Your booking/calendar API (e.g. Acuity, Calendly, JaneApp, Boulevard)
CALENDAR_API_URL=https://acuityscheduling.com/api/v1
CALENDAR_API_KEY=your_calendar_api_key
# Public booking link sent in missed-call recovery SMS
BOOKING_URL=https://calendly.com/your-link

# ── CRM (HUBSPOT) ──────────────────────────────────────────────────────────────
# Private app access token from HubSpot developer settings
HUBSPOT_API_KEY=your_hubspot_private_app_token
