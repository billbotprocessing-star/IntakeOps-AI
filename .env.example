# ── VAPI VOICE ENGINE ──────────────────────────────────────────────────────────
VAPI_API_KEY=your_vapi_key_here

# ── LLM BRAIN ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here

# ── N8N AUTOMATION ─────────────────────────────────────────────────────────────
# Base URL of your n8n instance (no trailing slash)
N8N_WEBHOOK_URL=https://your-instance.n8n.cloud/webhook

# ── INTAKEOPS BACKEND ──────────────────────────────────────────────────────────
# URL where the FastAPI backend is hosted (e.g. Railway, Render, fly.io)
CRM_WEBHOOK_URL=https://your-intakeops-backend.up.railway.app
# Secret key shared between n8n and the backend
INTAKEOPS_API_KEY=generate_a_random_secret_here

# ── TWILIO SMS ─────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Phone number to page for emergencies
ON_CALL_PHONE=+1XXXXXXXXXX

# ── CALENDAR INTEGRATION ───────────────────────────────────────────────────────
# Your booking/calendar API (e.g. Acuity, Calendly, JaneApp, Boulevard)
CALENDAR_API_URL=https://acuityscheduling.com/api/v1
CALENDAR_API_KEY=your_calendar_api_key
# Public booking link sent in missed-call recovery SMS
BOOKING_URL=https://calendly.com/your-link

# ── CRM (HUBSPOT) ──────────────────────────────────────────────────────────────
# Private app access token from HubSpot developer settings
HUBSPOT_API_KEY=your_hubspot_private_app_token
