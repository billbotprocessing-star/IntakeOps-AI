      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// ✏️  FILL IN THE VALUES BELOW, then click Save.\n// Every other node in this workflow reads its settings from here.\nreturn [{\n  json: {\n    // Your Netlify site + /api (no trailing slash)\n    site_api_url: \"https://intake-ops-ai.netlify.app/api\",\n    // Must match INTAKEOPS_API_KEY in Netlify exactly\n    intakeops_api_key: \"PASTE_YOUR_INTAKEOPS_API_KEY\",\n    // Your Twilio number, e.g. +15551234567\n    twilio_from_number: \"+15550000000\",\n    // Who gets paged for emergencies\n    on_call_phone: \"+15550000000\",\n  },\n}];"
      },
      "id": "edd3efc9-0a9f-5696-96bb-9a15abb79b63",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const req = $('Triage Request').first().json;\nconst b = req.body ?? req;\nconst urgencyRaw = String(b.urgency_level ?? '').toLowerCase();\nconst urgency = ['emergency', 'high', 'standard', 'unqualified'].includes(urgencyRaw) ? urgencyRaw : 'unqualified';\nconst industryRaw = String(b.industry ?? '').toLowerCase();\nconst base = {\n  call_id: String(b.call_id || `triage-${Date.now()}`),\n  caller_phone: String(b.caller_phone ?? ''),\n  caller_name: String(b.caller_name || 'Unknown'),\n  issue_description: String(b.issue_description ?? ''),\n  urgency_level: urgency,\n  service_address: String(b.service_address ?? ''),\n  industry: ['plumbing', 'legal', 'med-spa', 'property-management', 'general'].includes(industryRaw) ? industryRaw : 'general',\n  timestamp: new Date().toISOString(),\n};\nconst TICKETS = {\n  emergency: { priority: 'CRITICAL', status: 'escalated' },\n  high: { priority: 'HIGH', status: 'pending_callback' },\n  standard: { priority: 'NORMAL', status: 'queued' },\n};\nreturn [{\n  json: {\n    ...base,\n    is_unqualified: urgency === 'unqualified',\n    is_emergency: urgency === 'emergency',\n    ticket: TICKETS[urgency] ? { ...base, ...TICKETS[urgency] } : null,\n  },\n}];"
      },
      "id": "35596043-56ad-5cb1-aea3-4e5a824f6165",
      "name": "Normalize Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
